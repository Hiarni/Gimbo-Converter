<Page
    x:Class="FilmKonverter.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:FilmKonverter.App"
    xmlns:b="clr-namespace:FilmKonverter.App.Behaviors"
    xmlns:app="clr-namespace:FilmKonverter.App"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Start"
    AllowDrop="True"
    DragEnter="OnDragOver"
    DragLeave="OnDragLeave"
    DragOver="OnDragOver"
    Drop="OnDrop"
    ScrollViewer.CanContentScroll="False">
    <Grid>
    <ScrollViewer b:Wheel.ScrollPage="True" VerticalScrollBarVisibility="Auto">
    <Grid Margin="24,8,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding RunTitle}" TextTrimming="CharacterEllipsis" />
            <TextBlock
                Height="36"
                Margin="0,4,0,8"
                LineHeight="18"
                LineStackingStrategy="BlockLineHeight"
                Style="{StaticResource Muted}"
                Text="{Binding StatusText}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                ToolTip="{Binding StatusText}" />
            <WrapPanel>
                <ComboBox
                    Width="230"
                    Margin="0,0,12,8"
                    DisplayMemberPath="Name"
                    IsEnabled="{Binding IsIdle}"
                    ItemsSource="{Binding Source={x:Static app:AppState.Instance}, Path=Profiles.Items}"
                    SelectedItem="{Binding Source={x:Static app:AppState.Instance}, Path=Profiles.Selected}" />
                <ui:Button
                    Margin="0,0,8,8"
                    Appearance="Primary"
                    Command="{Binding StartCommand}"
                    Content="Start"
                    Icon="{ui:SymbolIcon Play24}" />
                <ui:Button
                    Margin="0,0,8,8"
                    Click="OnPickSelection"
                    Content="{l:T 'Vorziehen …', 'Prioritise …'}"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    ToolTip="{l:T 'Bestimmte Serien oder Staffeln vorziehen: sie kommen in die Warteschlange. Ordner und Dateien lassen sich auch einfach hierher ziehen.', 'Prioritise certain series or seasons: they go into the queue. Folders and files can also simply be dragged here.'}" />
                <ui:Button
                    Margin="0,0,8,8"
                    Command="{Binding PauseCommand}"
                    Content="{Binding IsPaused, Converter={StaticResource BoolText}, ConverterParameter={l:T 'Fortsetzen|Pause', 'Resume|Pause'}}"
                    Icon="{ui:SymbolIcon Pause24}" />
                <ui:Button
                    Margin="0,0,8,8"
                    Command="{Binding StopAfterCurrentCommand}"
                    Content="{l:T 'Nach laufenden Dateien stoppen', 'Stop after current files'}"
                    Icon="{ui:SymbolIcon Stop24}" />
                <ui:Button
                    Margin="0,0,8,8"
                    Appearance="Danger"
                    Command="{Binding CancelCommand}"
                    Content="{l:T 'Abbrechen', 'Cancel'}"
                    Icon="{ui:SymbolIcon Dismiss24}" />
            </WrapPanel>
            <TextBlock
                Margin="2,2,0,0"
                Style="{StaticResource Muted}"
                Text="{Binding Source={x:Static app:AppState.Instance}, Path=Profiles.SelectedSummary}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border
                Margin="0,0,0,12"
                Padding="14,10"
                Background="#332F81F7"
                BorderBrush="#2F81F7"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding UpdateNotice, Converter={StaticResource TextVis}}">
                <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding UpdateNotice}" TextWrapping="Wrap" />
            </Border>
            <Border
                Margin="0,0,0,12"
                Padding="14,10"
                Background="#33DA3633"
                BorderBrush="#DA3633"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding SettingsWarning, Converter={StaticResource TextVis}}">
                <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SettingsWarning}" TextWrapping="Wrap" />
            </Border>
            <Border
                Margin="0,0,0,12"
                Padding="14,10"
                Background="#33DA3633"
                BorderBrush="#DA3633"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding ErrorText, Converter={StaticResource TextVis}}">
                <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ErrorText}" TextWrapping="Wrap" />
            </Border>
            <Border
                Margin="0,0,0,12"
                Padding="14,10"
                Background="#26D29922"
                BorderBrush="#D29922"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding SpaceWarning, Converter={StaticResource TextVis}}">
                <DockPanel>
                    <ui:SymbolIcon Margin="0,0,10,0" VerticalAlignment="Center" Symbol="Warning24" />
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SpaceWarning}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <Border
                Margin="0,0,0,12"
                Padding="14,8"
                Background="#262F81F7"
                BorderBrush="#2F81F7"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding BannerText, Converter={StaticResource TextVis}}">
                <DockPanel>
                    <ui:Button
                        Margin="12,0,0,0"
                        Command="{Binding CancelPendingCommand}"
                        Content="{l:T 'Abbrechen', 'Cancel'}"
                        DockPanel.Dock="Right"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        Visibility="{Binding BannerCancelable, Converter={StaticResource BoolVis}}" />
                    <ui:SymbolIcon Margin="0,0,10,0" VerticalAlignment="Center" Symbol="Clock24" />
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding BannerText}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>
            <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Foreground="#3FB950" Style="{StaticResource BigNumber}" Text="{Binding CountNew}" />
                    <TextBlock FontSize="13" Style="{StaticResource Muted}" Text="{l:T 'komprimiert', 'compressed'}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="1" Margin="0,0,8,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource BigNumber}" Text="{Binding CountOk}" />
                    <TextBlock FontSize="13" Style="{StaticResource Muted}" Text="{l:T 'bereits vorhanden', 'already done'}" ToolTip="{l:T 'Zieldatei existiert schon und erfüllt die Vorgaben', 'Target file already exists and meets the requirements'}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="2" Margin="0,0,8,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Foreground="#E3B341" Style="{StaticResource BigNumber}" Text="{Binding CountSkipped}" />
                    <TextBlock FontSize="13" Style="{StaticResource Muted}" Text="{l:T 'übersprungen', 'skipped'}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="3" Margin="0,0,8,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{StaticResource BigNumber}" Text="{Binding CountOther}" />
                    <TextBlock FontSize="13" Style="{StaticResource Muted}" Text="{l:T 'auf anderen PCs', 'on other PCs'}" ToolTip="{l:T 'Gerade von einem anderen PC bearbeitet', 'Currently being processed by another PC'}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="4" Margin="0,0,8,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Foreground="#F85149" Style="{StaticResource BigNumber}" Text="{Binding CountErrors}" />
                    <TextBlock FontSize="13" Style="{StaticResource Muted}" Text="{l:T 'Fehler', 'errors'}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="5" Padding="16,12">
                <StackPanel>
                    <TextBlock Foreground="#2F81F7" Style="{StaticResource BigNumber}" Text="{Binding GainText}" />
                    <TextBlock FontSize="13" Style="{StaticResource Muted}" Text="{l:T 'gewonnen', 'saved'}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </ui:Card>
        </Grid>

        <StackPanel Grid.Row="3">
            <TextBlock
                Margin="2,-4,2,10"
                FontSize="12"
                Style="{StaticResource Muted}"
                Text="{Binding SinceStartText}"
                Visibility="{Binding SinceStartText, Converter={StaticResource TextVis}}" />
            <ui:Card Margin="0,0,0,12" Padding="20,12" Visibility="{Binding HasPeers, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding Peers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Margin="0,5,10,0" VerticalAlignment="Top" Fill="{Binding Active, Converter={StaticResource WarnBrush}, ConverterParameter=peer}" />
                                <StackPanel Grid.Column="1" MinWidth="180" Margin="0,0,16,0">
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Machine}" />
                                    <TextBlock FontSize="12" Style="{StaticResource Muted}" Text="{Binding Headline}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:Card>

            <ui:Card Margin="0,0,0,12" Padding="20,12" Visibility="{Binding HasQueue, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <ui:Button Padding="8,4" Appearance="Transparent" Command="{Binding QueueClearCommand}" Content="{l:T 'Leeren', 'Clear'}" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Delete24}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="{l:T 'Warteschlange (vor der normalen Reihenfolge, für alle PCs)', 'Queue (ahead of the normal order, for all PCs)'}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Queue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Muted}" Text="{Binding Detail}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <ui:Button Padding="6" Appearance="Transparent" Command="{Binding DataContext.QueueUpCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon ArrowUp24}" ToolTip="{l:T 'Nach vorn', 'Move up'}" />
                                        <ui:Button Padding="6" Appearance="Transparent" Command="{Binding DataContext.QueueDownCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon ArrowDown24}" ToolTip="{l:T 'Nach hinten', 'Move down'}" />
                                        <ui:Button Padding="6" Appearance="Transparent" Command="{Binding DataContext.QueueRemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="{l:T 'Entfernen', 'Remove'}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <Grid Margin="2,0,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="13" Style="{StaticResource Muted}" Text="{l:T 'Gesamt', 'Overall'}" />
                <ProgressBar Grid.Column="1" Height="4" Margin="12,0,12,0" VerticalAlignment="Center" Maximum="100" Value="{Binding ListPercent}" />
                <TextBlock Grid.Column="2" FontSize="13" Style="{StaticResource Muted}" Text="{Binding DoneText}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,12" Padding="20,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding CurrentName}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding CurrentName}" />
                                    <TextBlock Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource Muted}" Text="{Binding CurrentPosition}" />
                                </Grid>

                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Label}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{Binding Kind, Converter={StaticResource LineKindBrush}}"
                                                    Text="{Binding Text}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Margin="0,14,0,0" Visibility="{Binding HasStage, Converter={StaticResource BoolVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding StageName}" />
                                        <ProgressBar
                                            Grid.Column="1"
                                            Height="8"
                                            VerticalAlignment="Center"
                                            IsIndeterminate="{Binding StageIndeterminate}"
                                            Maximum="100"
                                            Value="{Binding StagePercent}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            MinWidth="70"
                                            Margin="12,0,0,0"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding PercentText}"
                                            TextAlignment="Right" />
                                    </Grid>
                                    <WrapPanel Margin="96,8,0,0">
                                        <StackPanel Margin="0,0,24,4" Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource StatCaption}" Text="{l:T 'Zeit', 'Time'}" />
                                            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding TimeText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,24,4" Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource StatCaption}" Text="{l:T 'Rest', 'Left'}" />
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding EtaText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,24,4" Orientation="Horizontal" Visibility="{Binding TempoText, Converter={StaticResource TextVis}}">
                                            <TextBlock Style="{StaticResource StatCaption}" Text="{l:T 'Tempo', 'Speed'}" />
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TempoText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,24,4" Orientation="Horizontal" Visibility="{Binding BitrateText, Converter={StaticResource TextVis}}">
                                            <TextBlock Style="{StaticResource StatCaption}" Text="{l:T 'Datenrate', 'Bitrate'}" />
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding BitrateText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,24,4" Orientation="Horizontal" Visibility="{Binding SizeText, Converter={StaticResource TextVis}}">
                                            <TextBlock Style="{StaticResource StatCaption}" Text="{l:T 'Bisher', 'So far'}" />
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SizeText}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal" Visibility="{Binding EstimateText, Converter={StaticResource TextVis}}">
                                            <TextBlock Style="{StaticResource StatCaption}" Text="{l:T 'Erwartet', 'Expected'}" />
                                            <TextBlock Foreground="{Binding EstimateWarn, Converter={StaticResource WarnBrush}}" Text="{Binding EstimateText}" />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ui:Card Grid.Row="4" Padding="0" VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="20,14,20,6" Style="{StaticResource SectionTitle}" Text="{l:T 'Verlauf', 'History'}" />
                <ItemsControl
                    Grid.Row="1"
                    Height="340"
                    Margin="12,0,12,10"
                    ItemsSource="{Binding History}"
                    ScrollViewer.CanContentScroll="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="116" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding TimeText}" />
                                <Border
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    Padding="6,2"
                                    HorizontalAlignment="Left"
                                    Background="{Binding Outcome, Converter={StaticResource OutcomeBrush}}"
                                    CornerRadius="4">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="{Binding Badge}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Name}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Muted}"
                                    Text="{Binding Message}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTip="{Binding Message}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ui:Card>
    </Grid>
    </ScrollViewer>
    <Border
        x:Name="DropHint"
        Margin="16"
        Background="#CC1B1F27"
        BorderBrush="#2F81F7"
        BorderThickness="2"
        CornerRadius="10"
        IsHitTestVisible="False"
        Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:SymbolIcon HorizontalAlignment="Center" FontSize="48" Foreground="#2F81F7" Symbol="ArrowDownload24" />
            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="White" Text="{l:T 'Loslassen: in die Warteschlange, kommt als Nächstes dran', 'Drop: into the queue, comes next'}" />
            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="#C9D1D9" Text="{l:T 'Serien-, Staffelordner oder einzelne Folgen aus dem Quellordner eines Profils', 'Series or season folders or single episodes from a profile source folder'}" />
        </StackPanel>
    </Border>
    </Grid>
</Page>
