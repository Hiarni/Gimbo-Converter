<Page
    x:Class="FilmKonverter.App.Pages.RepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:FilmKonverter.App"
    xmlns:b="clr-namespace:FilmKonverter.App.Behaviors"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root"
    Title="{l:T 'Reparieren', 'Repair'}"
    ScrollViewer.CanContentScroll="False">

    <Grid Margin="24,8,24,20" AllowDrop="True" Background="Transparent" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T 'Reparieren', 'Repair'}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}" Text="{l:T 'Macht fertige Dateien wieder direkt abspielbar: ein zu hoher HEVC-Level wird verlustfrei korrigiert, Ton, den Fernseher nicht können, wird umgewandelt. Alles andere bleibt. Jede Datei wird geprüft, bevor sie das Original am selben Ort ersetzt.', 'Makes finished files play directly again: a too high HEVC level is corrected losslessly, audio that TVs cannot play is converted. Everything else stays. Every file is checked before it replaces the original in the same place.'}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Margin="0,0,16,0" b:Wheel.ScrollPage="True" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ui:Card Margin="0,0,0,8" Padding="16,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T 'Video', 'Video'}" />
                            <TextBlock FontSize="12" Style="{StaticResource Muted}" Text="{l:T 'Ein HEVC-Level über 5.1 (z.B. 6.2) wird auf den Wert gesetzt, der zur Auflösung passt. Das Bild wird nicht neu kodiert und bleibt bit-genau gleich. Level bis 5.1 bleiben, sie können berechtigt sein.', 'An HEVC level above 5.1 (e.g. 6.2) is set to the value that matches the resolution. The picture is not re-encoded and stays bit-identical. Levels up to 5.1 stay, they can be legitimate.'}" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,0,0,8" Padding="16,12" IsEnabled="{Binding IsIdle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T 'Ton, der bleibt', 'Audio that stays'}" />
                            <TextBlock Margin="0,0,0,6" FontSize="12" Style="{StaticResource Muted}" Text="{l:T 'Diese Formate spielt der Fernseher direkt ab, sie werden unverändert kopiert. Alles andere (z.B. DTS, TrueHD, FLAC, PCM) wird umgewandelt.', 'The TV plays these formats directly, they are copied unchanged. Everything else (e.g. DTS, TrueHD, FLAC, PCM) is converted.'}" />
                            <ItemsControl ItemsSource="{Binding AllowedAudio}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="0,0,0,2" Content="{Binding Text}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,6,0,0" FontSize="12" Style="{StaticResource Muted}" Text="{l:T 'Meldet der Medienserver bei E-AC3 weiterhin „Audio nicht unterstützt“, E-AC3 hier abwählen.', 'If the media server still reports “audio not supported” for E-AC3, untick E-AC3 here.'}" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Padding="16,12" IsEnabled="{Binding IsIdle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T 'Umwandeln nach', 'Convert to'}" />
                            <RadioButton Margin="0,0,0,4" Content="{l:T 'AC3 (Dolby Digital, läuft auf jedem Fernseher)', 'AC3 (Dolby Digital, plays on every TV)'}" GroupName="RepairTarget" IsChecked="{Binding TargetAc3, Mode=TwoWay}" />
                            <RadioButton Content="E-AC3 (Dolby Digital Plus)" GroupName="RepairTarget" IsChecked="{Binding TargetAc3, Converter={StaticResource Not}, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T 'Datenrate für 5.1 (AC3 höchstens 640k, Stereo 256k)', 'Bitrate for 5.1 (AC3 at most 640k, stereo 256k)'}" />
                            <ComboBox Width="110" HorizontalAlignment="Left" DisplayMemberPath="Text" ItemsSource="{Binding BitrateOptions}" SelectedValue="{Binding Bitrate}" SelectedValuePath="Value" />
                            <TextBlock Margin="0,8,0,0" FontSize="12" Style="{StaticResource Muted}" Text="{l:T '7.1 wird 5.1. Untertitel, Kapitel, Sprachen, Standardspur und Titelbild bleiben. Das Änderungsdatum wird das bisherige plus 2 Sekunden, damit der Medienserver die Datei neu einliest.', '7.1 becomes 5.1. Subtitles, chapters, languages, default track and cover picture stay. The modified date becomes the previous one plus 2 seconds, so the media server reads the file again.'}" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Appearance="Primary" Command="{Binding StartCommand}" Content="{l:T 'Reparieren', 'Repair'}" Icon="{ui:SymbolIcon Wrench24}" Visibility="{Binding IsIdle, Converter={StaticResource BoolVis}}" />
                            <ui:Button Command="{Binding TogglePauseCommand}" Content="{Binding IsPaused, Converter={StaticResource BoolText}, ConverterParameter={l:T 'Fortsetzen|Pause', 'Resume|Pause'}}" Icon="{ui:SymbolIcon Pause24}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                            <ui:Button Margin="8,0,0,0" Command="{Binding StopCommand}" Content="{l:T 'Abbrechen', 'Cancel'}" Icon="{ui:SymbolIcon Stop24}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                        <WrapPanel>
                            <ui:Button Margin="0,0,8,4" Command="{Binding AddFilesCommand}" Content="{l:T 'Dateien …', 'Files …'}" Icon="{ui:SymbolIcon DocumentAdd24}" />
                            <ui:Button Margin="0,0,8,4" Command="{Binding AddFolderCommand}" Content="{l:T 'Ordner …', 'Folder …'}" Icon="{ui:SymbolIcon FolderAdd24}" />
                            <ui:Button Margin="0,0,8,4" Command="{Binding RemoveFinishedCommand}" Icon="{ui:SymbolIcon CheckmarkCircle24}" ToolTip="{l:T 'Reparierte und passende aus der Liste nehmen', 'Remove repaired and fine ones from the list'}" />
                            <ui:Button Margin="0,0,8,4" Command="{Binding ClearCommand}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="{l:T 'Liste leeren', 'Clear list'}" />
                        </WrapPanel>
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}" Text="{Binding Summary}" />
                    <ProgressBar Height="4" Margin="0,8,0,0" Maximum="100" Value="{Binding TotalPercent}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    Padding="12,8"
                    Background="#262F81F7"
                    BorderBrush="#2F81F7"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding Message, Converter={StaticResource TextVis}}">
                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Message}" TextWrapping="Wrap" />
                </Border>

                <ui:Card Grid.Row="2" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasRows, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                            <ui:SymbolIcon HorizontalAlignment="Center" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="ArrowDownload24" />
                            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T 'MKV- und MP4-Dateien oder Ordner hierher ziehen', 'Drag MKV and MP4 files or folders here'}" />
                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource Muted}" Text="{l:T 'Vor dem Start zeigt jede Zeile, was geändert wird. Dateien ohne Problem werden nicht angefasst.', 'Before starting, each row shows what will be changed. Files without a problem are not touched.'}" />
                        </StackPanel>

                        <ItemsControl
                            Margin="8,8,4,8"
                            ItemsSource="{Binding Rows}"
                            ScrollViewer.CanContentScroll="True"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,4,6" Padding="12,8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Margin="0,5,0,0" VerticalAlignment="Top" Fill="{Binding StateBrush}" />
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" />
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SourceText}" TextWrapping="Wrap" ToolTip="{Binding Folder}" />
                                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding PlanText}" TextWrapping="Wrap" Visibility="{Binding PlanText, Converter={StaticResource TextVis}}" />
                                                <TextBlock FontSize="12" Foreground="#E3B341" Text="{Binding NoteText}" TextWrapping="Wrap" Visibility="{Binding NoteText, Converter={StaticResource TextVis}}" />
                                                <ProgressBar Height="4" Margin="0,6,0,0" Maximum="100" Value="{Binding Percent}" Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" MaxWidth="260" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ProgressText}" Visibility="{Binding ProgressText, Converter={StaticResource TextVis}}" />
                                                <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{Binding ResultBrush}" Text="{Binding ResultText}" TextAlignment="Right" TextWrapping="Wrap" Visibility="{Binding ResultText, Converter={StaticResource TextVis}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                                                <ui:Button
                                                    Padding="6"
                                                    Appearance="Transparent"
                                                    Command="{Binding DataContext.OpenRowCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Icon="{ui:SymbolIcon FolderOpen24}"
                                                    ToolTip="{l:T 'Im Explorer zeigen', 'Show in Explorer'}" />
                                                <ui:Button
                                                    Padding="6"
                                                    Appearance="Transparent"
                                                    Command="{Binding DataContext.RemoveRowCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Icon="{ui:SymbolIcon Dismiss24}"
                                                    IsEnabled="{Binding CanRemove}"
                                                    ToolTip="{l:T 'Aus der Liste nehmen', 'Remove from the list'}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</Page>
