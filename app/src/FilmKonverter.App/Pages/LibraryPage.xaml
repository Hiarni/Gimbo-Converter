<Page
    x:Class="FilmKonverter.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:FilmKonverter.App"
    xmlns:b="clr-namespace:FilmKonverter.App.Behaviors"
    xmlns:app="clr-namespace:FilmKonverter.App"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root"
    Title="Bibliothek"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <DataTemplate x:Key="ShareRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" />
                <ProgressBar Grid.Column="1" Height="6" VerticalAlignment="Center" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                <TextBlock Grid.Column="2" MinWidth="150" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Muted}" Text="{Binding Text}" TextAlignment="Right" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid Margin="24,8,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T 'Bibliothek', 'Library'}" />
            <TextBlock Margin="0,4,0,12" Style="{StaticResource Muted}" Text="{l:T 'Liest die ganze Quelle und zeigt, wo das meiste Platzpotenzial steckt. Ergebnisse werden zwischengespeichert: der zweite Durchgang dauert Sekunden.', 'Reads the whole source and shows where the most space can be saved. Results are cached: the second pass takes seconds.'}" TextWrapping="Wrap" />
            <WrapPanel>
                <ComboBox
                    Width="230"
                    Margin="0,0,12,8"
                    DisplayMemberPath="Name"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                    ItemsSource="{Binding Source={x:Static app:AppState.Instance}, Path=Profiles.Items}"
                    SelectedItem="{Binding Source={x:Static app:AppState.Instance}, Path=Profiles.Selected}" />
                <ui:Button Margin="0,0,8,8" Appearance="Primary" Command="{Binding AnalyzeCommand}" Content="{l:T 'Analysieren', 'Analyse'}" Icon="{ui:SymbolIcon DataPie24}" />
                <ui:Button Margin="0,0,8,8" Command="{Binding CancelCommand}" Content="{l:T 'Abbrechen', 'Cancel'}" Icon="{ui:SymbolIcon Dismiss24}" />
                <ui:Button Margin="0,0,8,8" Command="{Binding EncodeAllCommand}" Content="{l:T 'Alles Offene kodieren (größtes Potenzial zuerst)', 'Encode everything open (largest saving first)'}" Icon="{ui:SymbolIcon Play24}" />
            </WrapPanel>
            <TextBlock Margin="2,0,0,0" FontSize="12" Style="{StaticResource Muted}" Text="{Binding ProfileText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border
                Margin="0,0,0,10"
                Padding="14,10"
                Background="#262F81F7"
                BorderBrush="#2F81F7"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding Message, Converter={StaticResource TextVis}}">
                <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Margin="0,0,0,10" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                <ProgressBar Height="4" IsIndeterminate="{Binding ProgressIndeterminate}" Maximum="100" Value="{Binding Progress}" />
                <TextBlock Margin="0,6,0,0" FontSize="12" Style="{StaticResource Muted}" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="2" Style="{StaticResource PageTabs}">
            <TabItem Header="{l:T 'Übersicht', 'Overview'}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="16,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding TotalText}" />
                            <TextBlock FontSize="12" Style="{StaticResource Muted}" Text="{Binding TotalDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Grid.Column="1" Margin="0,0,8,0" Padding="16,12">
                        <StackPanel>
                            <TextBlock Foreground="#3FB950" Style="{StaticResource BigNumber}" Text="{Binding DoneText}" />
                            <TextBlock FontSize="12" Style="{StaticResource Muted}" Text="{Binding DoneDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Grid.Column="2" Margin="0,0,8,0" Padding="16,12">
                        <StackPanel>
                            <TextBlock Foreground="#E3B341" Style="{StaticResource BigNumber}" Text="{Binding OpenText}" />
                            <TextBlock FontSize="12" Style="{StaticResource Muted}" Text="{Binding OpenDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Grid.Column="3" Padding="16,12">
                        <StackPanel>
                            <TextBlock Foreground="#2F81F7" Style="{StaticResource BigNumber}" Text="{Binding SavingText}" />
                            <TextBlock FontSize="12" Style="{StaticResource Muted}" Text="{Binding SavingDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,10" Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="16,12" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" Style="{StaticResource SectionTitle}" Text="{l:T 'Video-Codecs (nach Größe)', 'Video codecs (by size)'}" />
                            <ItemsControl ItemsSource="{Binding Codecs}" ItemTemplate="{StaticResource ShareRowTemplate}" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Grid.Column="1" Padding="16,12" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" Style="{StaticResource SectionTitle}" Text="{l:T 'Auflösung der Quellen', 'Source resolution'}" />
                            <ItemsControl ItemsSource="{Binding Resolutions}" ItemTemplate="{StaticResource ShareRowTemplate}" />
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <ui:Card Grid.Row="2" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="16,10,16,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="{l:T 'Nur mit offenen Dateien', 'Only with open files'}" IsChecked="{Binding OnlyOpen}" />
                                <ui:TextBox Width="170" Margin="0,0,8,0" Icon="{ui:SymbolIcon Search24}" PlaceholderText="{l:T 'Suchen …', 'Search …'}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Width="210" DisplayMemberPath="Text" ItemsSource="{Binding Sorts}" SelectedValue="{Binding Sort}" SelectedValuePath="Key" />
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="{l:T 'Serien und Filme', 'Series and movies'}" />
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="16,6,28,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="3.6*" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T 'Name', 'Name'}" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T 'Dateien', 'Files'}" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T 'Größe', 'Size'}" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T 'Ø Datenrate', 'Avg bitrate'}" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Margin="12,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Codec" />
                            <TextBlock Grid.Column="5" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T 'Fertig', 'Done'}" />
                            <TextBlock Grid.Column="6" Margin="12,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T 'Offen · Ersparnis (geschätzt)', 'Open · saving (est.)'}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <ItemsControl
                            Grid.Row="2"
                            Margin="16,0,12,8"
                            ItemsSource="{Binding Groups}"
                            ScrollViewer.CanContentScroll="True"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,14,3" Background="Transparent" ToolTip="{Binding Tooltip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="3.6*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding FilesText}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SizeText}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding RateText}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CodecText}" TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Column="5" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Height="4" VerticalAlignment="Center" Maximum="100" Value="{Binding DonePercent, Mode=OneWay}" />
                                            <TextBlock Grid.Column="1" FontSize="12" Style="{StaticResource Muted}" Text="{Binding DoneText}" TextAlignment="Right" TextWrapping="NoWrap" />
                                        </Grid>
                                        <Grid Grid.Column="6" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DockPanel>
                                                <TextBlock Margin="8,0,0,0" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#2F81F7" Text="{Binding SavingText}" />
                                                <TextBlock FontSize="12" Style="{StaticResource Muted}" Text="{Binding OpenText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </DockPanel>
                                            <Border Grid.Row="1" Height="3" Margin="0,3,0,0" HorizontalAlignment="Left" Background="#2F81F7" CornerRadius="1.5">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource PercentWidth}">
                                                        <Binding Path="SavingBar" />
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="7" Margin="4,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                            <ui:Button
                                                Padding="6"
                                                Appearance="Transparent"
                                                Command="{Binding DataContext.OpenGroupFolderCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon FolderOpen24}"
                                                ToolTip="{l:T 'Im Explorer zeigen', 'Show in Explorer'}" />
                                            <ui:Button
                                                Padding="6"
                                                Appearance="Transparent"
                                                Command="{Binding DataContext.EncodeGroupCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon Play24}"
                                                IsEnabled="{Binding CanEncode}"
                                                ToolTip="{l:T 'Jetzt kodieren', 'Encode now'}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ui:Card>

                <TextBlock Grid.Row="3" Margin="2,8,0,0" FontSize="12" Style="{StaticResource Muted}" Text="{Binding Footer}" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="{Binding DuplicatesHeader}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,0,10">
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Top" DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0" Command="{Binding CheckDuplicatesCommand}" Content="{l:T '1. Prüfen', '1. Check'}" Icon="{ui:SymbolIcon Search24}" ToolTip="{l:T 'Vergleicht die Dateien im selben Ordner und zeigt für jede, was mit ihr passieren würde. Löscht nichts.', 'Compares the files in the same folder and shows for each one what would happen to it. Deletes nothing.'}" />
                            <ui:Button Command="{Binding DeleteDuplicatesCommand}" Content="{l:T '2. Löschen …', '2. Delete …'}" Icon="{ui:SymbolIcon Delete24}" ToolTip="{l:T 'Löscht nach einer Rückfrage die Dateien, bei denen „Wird gelöscht“ steht. Erst nach dem Prüfen möglich.', 'Deletes, after asking, the files marked “Will be deleted”. Only possible after checking.'}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding DuplicatesSummary}" TextWrapping="Wrap" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Duplicates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,0,0,8" Padding="16,10">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" />
                                            <TextBlock Margin="0,2,0,6" FontSize="12" Style="{StaticResource Muted}" Text="{Binding Subtitle}" />
                                            <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="#E3B341" Text="{Binding Note}" TextWrapping="Wrap" Visibility="{Binding Note, Converter={StaticResource TextVis}}" />
                                            <ItemsControl ItemsSource="{Binding Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="5*" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="3*" />
                                                                <ColumnDefinition Width="40" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Size}" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Muted}" Text="{Binding Details}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Details}" />
                                                            <ui:Button Grid.Column="3" Padding="6" HorizontalAlignment="Right" Appearance="Transparent" Command="{Binding DataContext.OpenDuplicateCommand, ElementName=Root}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{l:T 'Im Explorer zeigen', 'Show in Explorer'}" />
                                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" FontSize="12" Style="{StaticResource Muted}" Text="{Binding Folder}" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,1,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{Binding DecisionColor}" Text="{Binding Decision}" TextWrapping="Wrap" Visibility="{Binding Decision, Converter={StaticResource TextVis}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding MissingHeader}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="2,0,0,10" Style="{StaticResource Muted}" Text="{Binding MissingSummary}" TextWrapping="Wrap" />
                    <ui:Card Grid.Row="1" Padding="16,10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Missing}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="4*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Group}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Season}" />
                                            <TextBlock Grid.Column="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Have}" />
                                            <TextBlock Grid.Column="3" FontWeight="SemiBold" Foreground="#E3B341" Text="{Binding Missing}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </ui:Card>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding ProblemsHeader}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <ComboBox Width="260" Margin="0,0,8,4" DisplayMemberPath="Text" ItemsSource="{Binding ProblemFilters}" SelectedValue="{Binding ProblemFilter}" SelectedValuePath="Key" />
                        <ui:Button Margin="0,0,8,4" Command="{Binding RefreshProblemsCommand}" Content="{l:T 'Aktualisieren', 'Refresh'}" Icon="{ui:SymbolIcon ArrowSync24}" />
                        <ui:Button Margin="0,0,8,4" Command="{Binding ResetAllSkipListCommand}" Content="{l:T 'Ausnahmeliste zurücksetzen …', 'Reset skip list …'}" Icon="{ui:SymbolIcon ArrowCounterclockwise24}" ToolTip="{l:T 'Alle angezeigten Einträge der Ausnahmeliste entfernen: der nächste Lauf versucht sie erneut', 'Remove all shown skip list entries: the next run tries them again'}" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Margin="2,0,0,8" Style="{StaticResource Muted}" Text="{Binding ProblemsSummary}" TextWrapping="Wrap" />
                    <ui:Card Grid.Row="2" Padding="12,8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding Problems}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="4*" />
                                            <ColumnDefinition Width="4*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>
                                        <Border Margin="0,0,10,0" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding Color}" CornerRadius="4">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="{Binding KindText}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Relative}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Relative}" />
                                        <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Muted}" Text="{Binding Reason}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Reason}" />
                                        <TextBlock Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Muted}" Text="{Binding TimeText}" />
                                        <StackPanel Grid.Column="4" HorizontalAlignment="Right" Orientation="Horizontal">
                                            <ui:Button Padding="6" Appearance="Transparent" Command="{Binding DataContext.OpenProblemCommand, ElementName=Root}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{l:T 'Im Explorer zeigen', 'Show in Explorer'}" />
                                            <ui:Button Padding="6" Appearance="Transparent" Command="{Binding DataContext.ResetProblemCommand, ElementName=Root}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon ArrowCounterclockwise24}" IsEnabled="{Binding CanReset}" ToolTip="{l:T 'Von der Ausnahmeliste nehmen: der nächste Lauf versucht es erneut', 'Remove from the skip list: the next run tries again'}" />
                                            <ui:Button Padding="6" Appearance="Transparent" Command="{Binding DataContext.EncodeProblemCommand, ElementName=Root}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Play24}" IsEnabled="{Binding CanEncode}" ToolTip="{l:T 'Jetzt erneut kodieren', 'Encode again now'}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ui:Card>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
