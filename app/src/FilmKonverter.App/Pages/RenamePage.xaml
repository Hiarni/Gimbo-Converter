<Page
    x:Class="FilmKonverter.App.Pages.RenamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:FilmKonverter.App"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root"
    Title="{l:T 'Umbenennen', 'Rename'}"
    ScrollViewer.CanContentScroll="False">
    <Grid Margin="24,8,24,20" AllowDrop="True" Background="Transparent" Drop="OnDrop" DragOver="OnDragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <DockPanel>
                <ComboBox Width="150" Margin="16,0,0,0" VerticalAlignment="Center" DisplayMemberPath="Text" DockPanel.Dock="Right" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" ItemsSource="{Binding Kinds}" SelectedValue="{Binding Kind}" SelectedValuePath="Kind" />
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:T 'Umbenennen', 'Rename'}" />
            </DockPanel>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}" Text="{l:T 'Bringt Folgen und Filme auf ein einheitliches Schema. Ordner bleiben unverändert, .nfo, Untertitel und Vorschaubilder wandern mit. Jeder Lauf lässt sich rückgängig machen.', 'Brings episodes and movies to one consistent scheme. Folders stay unchanged, .nfo, subtitles and thumbnails move along. Every run can be undone.'}" TextWrapping="Wrap" />
        </StackPanel>

        <ui:Card Grid.Row="1" Margin="0,0,0,8" Padding="16,12">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding AddFolderCommand}" Content="{l:T 'Ordner …', 'Folder …'}" Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button Margin="8,0,0,0" Command="{Binding AddFilesCommand}" Content="{l:T 'Dateien …', 'Files …'}" Icon="{ui:SymbolIcon DocumentAdd24}" />
                        <ui:Button Margin="8,0,0,0" Click="OnRecentClick" Content="{l:T 'Zuletzt', 'Recent'}" Icon="{ui:SymbolIcon History24}" IsEnabled="{Binding HasRecent}" ToolTip="{l:T 'Zuletzt benutzte Ordner', 'Recently used folders'}" />
                        <ui:Button Margin="8,0,0,0" Command="{Binding ClearSourcesCommand}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="{l:T 'Auswahl leeren', 'Clear selection'}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SourceHint}" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Style="{StaticResource Muted}" Text="{Binding SourcesText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SourcesText}" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding LibraryText}" TextWrapping="Wrap" Visibility="{Binding LibraryText, Converter={StaticResource TextVis}}" />
            </StackPanel>
        </ui:Card>

        <ui:CardExpander Grid.Row="2" Margin="0,0,0,8" Icon="{ui:SymbolIcon TextEditStyle24}" IsExpanded="{Binding SchemaExpanded, Mode=TwoWay}">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{l:T 'Schema und Optionen', 'Scheme and options'}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Example}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4" Style="{StaticResource FieldLabel}" Text="{l:T 'Vorlage', 'Preset'}" />
                        <DockPanel>
                            <ui:Button Margin="8,0,0,0" Command="{Binding DeletePresetCommand}" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Delete24}" ToolTip="{l:T 'Eigene Vorlage löschen', 'Delete own preset'}" />
                            <ui:Button Margin="8,0,0,0" Command="{Binding SavePresetCommand}" Content="{l:T 'Speichern', 'Save'}" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Save24}" ToolTip="{l:T 'Aktuelles Schema unter diesem Namen speichern (gleicher Name = überschreiben)', 'Save the current scheme under this name (same name = overwrite)'}" />
                            <ui:TextBox Width="220" Margin="8,0,0,0" DockPanel.Dock="Right" PlaceholderText="{l:T 'Name für eigene Vorlage', 'Name for own preset'}" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox DisplayMemberPath="Display" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" />
                        </DockPanel>
                        <TextBlock Margin="0,10,0,4" Style="{StaticResource FieldLabel}" Text="{l:T 'Schema', 'Scheme'}" />
                        <TextBox x:Name="SchemaBox" Text="{Binding Template, UpdateSourceTrigger=PropertyChanged, Delay=500}" />
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Tokens}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button Margin="0,0,6,4" Padding="8,3" Click="OnTokenClick" Content="{Binding}" FontFamily="Consolas" Tag="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
                <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Example}" />
                <TextBlock Foreground="#E3B341" Text="{Binding TemplateWarning}" TextWrapping="Wrap" Visibility="{Binding TemplateWarning, Converter={StaticResource TextVis}}" />
                <TextBlock FontSize="12" Style="{StaticResource Muted}" Text="{Binding TokenHelp}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,8,0,0">
                    <DockPanel Margin="0,0,24,4">
                        <ui:ToggleSwitch Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="{Binding UseNfo}" />
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:T 'Titel aus .nfo-Dateien', 'Titles from .nfo files'}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,24,4">
                        <ui:ToggleSwitch Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="{Binding IncludeTarget}" />
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:T 'Komprimierte Dateien und Konverter-Vermerke mitziehen', 'Also rename compressed files and converter notes'}" />
                    </DockPanel>
                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding FilterLabel}" />
                        <TextBox Width="140" Text="{Binding SeriesFilter, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </ui:CardExpander>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <Border
                Margin="0,0,0,8"
                Padding="12,8"
                Background="#262F81F7"
                BorderBrush="#2F81F7"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding Message, Converter={StaticResource TextVis}}">
                <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>
            <ProgressBar Height="4" Margin="0,0,0,8" IsIndeterminate="{Binding ProgressIndeterminate}" Maximum="100" Value="{Binding Progress}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
            <TextBlock Margin="0,0,0,6" Style="{StaticResource Muted}" Text="{Binding Summary}" TextWrapping="Wrap" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:Button Margin="8,0,0,4" Command="{Binding AnalyzeCommand}" Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="{l:T 'Neu einlesen', 'Re-scan'}" />
                    <ui:Button Margin="8,0,0,4" Appearance="Primary" Command="{Binding ExecuteCommand}" Icon="{ui:SymbolIcon Rename24}">
                        <ui:Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:T 'Umbenennen', 'Rename'}" />
                                <TextBlock Margin="4,0,0,0" Text="{Binding SelectedCount, StringFormat='({0:N0})'}" />
                            </StackPanel>
                        </ui:Button.Content>
                    </ui:Button>
                </StackPanel>
            <WrapPanel>
                <ComboBox Width="190" Margin="0,0,8,4" DisplayMemberPath="Text" ItemsSource="{Binding Filters}" SelectedValue="{Binding Filter}" SelectedValuePath="Key" />
                <ui:TextBox Width="180" Margin="0,0,8,4" Icon="{ui:SymbolIcon Search24}" PlaceholderText="{l:T 'Suchen …', 'Search …'}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Margin="0,0,8,4" Command="{Binding SelectSafeCommand}" Content="{l:T 'Nur sichere', 'Safe only'}" Icon="{ui:SymbolIcon CheckmarkCircle24}" />
                <ui:Button Margin="0,0,8,4" Command="{Binding SelectAllVisibleCommand}" Content="{l:T 'Angezeigte', 'Shown'}" Icon="{ui:SymbolIcon SelectAllOn24}" />
                <ui:Button Margin="0,0,8,4" Command="{Binding SelectNoneCommand}" Content="{l:T 'Keine', 'None'}" Icon="{ui:SymbolIcon SelectAllOff24}" />
            </WrapPanel>
            </DockPanel>
        </StackPanel>

        <ui:Card Grid.Row="4" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" IsEnabled="{Binding IsExecuting, Converter={StaticResource Not}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="12,10,24,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T 'Bisher', 'Current'}" />
                    <TextBlock Grid.Column="3" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T 'Neu (änderbar)', 'New (editable)'}" />
                    <TextBlock Grid.Column="5" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T 'Hinweis', 'Note'}" />
                </Grid>
                <ItemsControl
                    Grid.Row="1"
                    Margin="12,0,8,8"
                    ItemsSource="{Binding View}"
                    ScrollViewer.CanContentScroll="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox MinWidth="0" VerticalAlignment="Center" IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" />
                                <Ellipse Grid.Column="1" Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding Status, Converter={StaticResource RenameStatusBrush}}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding OldPath}"
                                    TextWrapping="Wrap"
                                    ToolTip="{Binding OldPath}" />
                                <DockPanel Grid.Column="3" Margin="8,0,0,0">
                                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding Extension}" />
                                    <TextBox VerticalAlignment="Center" Text="{Binding NewName, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" ToolTip="{Binding NewName}" />
                                </DockPanel>
                                <StackPanel Grid.Column="4" Margin="4,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                    <ui:Button
                                        Padding="6"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.OpenRowFolderCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:SymbolIcon FolderOpen24}"
                                        ToolTip="{l:T 'Im Explorer zeigen', 'Show in Explorer'}" />
                                    <ui:Button
                                        Padding="6"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.ResetRowCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:SymbolIcon ArrowReset24}"
                                        ToolTip="{l:T 'Vorschlag wiederherstellen', 'Restore suggestion'}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="5"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Style="{StaticResource Muted}"
                                    Text="{Binding Notes}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTip="{Binding Notes}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ui:Card>

        <ui:Card Grid.Row="5" Margin="0,8,0,0" Padding="16,10">
            <DockPanel>
                <ui:Button Margin="8,0,0,0" Command="{Binding DeleteAllJournalsCommand}" Content="{l:T 'Alle löschen', 'Delete all'}" DockPanel.Dock="Right" Icon="{ui:SymbolIcon DeleteDismiss24}" ToolTip="{l:T 'Alle früheren Läufe aus der Liste löschen (die Dateien bleiben, wie sie sind)', 'Delete all previous runs from the list (the files stay as they are)'}" />
                <ui:Button Margin="8,0,0,0" Command="{Binding DeleteJournalCommand}" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Delete24}" ToolTip="{l:T 'Gewählten Lauf aus der Liste löschen (die Dateien bleiben, wie sie sind)', 'Delete the selected run from the list (the files stay as they are)'}" />
                <ui:Button Margin="8,0,0,0" Command="{Binding UndoCommand}" Content="{l:T 'Rückgängig machen', 'Undo'}" DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowUndo24}" />
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" DockPanel.Dock="Left" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:T 'Frühere Läufe', 'Previous runs'}" />
                <ComboBox DisplayMemberPath="Text" ItemsSource="{Binding Journals}" SelectedItem="{Binding SelectedJournal}" />
            </DockPanel>
        </ui:Card>
    </Grid>
</Page>
