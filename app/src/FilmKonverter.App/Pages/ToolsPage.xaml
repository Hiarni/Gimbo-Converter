<Page
    x:Class="FilmKonverter.App.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:FilmKonverter.App"
    xmlns:b="clr-namespace:FilmKonverter.App.Behaviors"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{l:T 'Werkzeuge', 'Tools'}"
    ScrollViewer.CanContentScroll="False">
    <ScrollViewer b:Wheel.ScrollPage="True" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,20">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T 'Werkzeuge', 'Tools'}" />
            <StackPanel Margin="0,4,0,16" Orientation="Horizontal">
                <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Verwendet das Profil: ', 'Uses the profile: '}" />
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ProfileName}" />
            </StackPanel>

            <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding Message}" TextWrapping="Wrap" Visibility="{Binding Message, Converter={StaticResource TextVis}}" />

            <ui:Card Margin="0,0,0,12" Padding="20,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T 'Testmodus: den richtigen Qualitätswert finden', 'Test mode: find the right quality value'}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Kodiert einen Ausschnitt einer Datei mit allen Testwerten des Profils und legt daneben den unveränderten Ausschnitt der Quelle. Misst die Bildqualität (SSIM) und zeigt per Bildvergleich, was jeder Wert kostet. Danach den Wert im Profil eintragen.', 'Encodes a clip of a file with all test values of the profile and puts the unchanged clip of the source next to it. Measures picture quality (SSIM) and shows in a picture comparison what each value costs. Then enter the value in the profile.'}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T 'Datei (am besten eine anspruchsvolle: dunkel, körnig, viel Bewegung)', 'File (preferably a demanding one: dark, grainy, lots of motion)'}" />
                    <DockPanel>
                        <ui:Button Margin="8,0,0,0" Command="{Binding PickTestFileCommand}" DockPanel.Dock="Right" Icon="{ui:SymbolIcon FolderOpen24}" />
                        <TextBox Text="{Binding TestFile, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <ui:Button Appearance="Primary" Command="{Binding StartTestCommand}" Content="{l:T 'Test starten', 'Start test'}" Icon="{ui:SymbolIcon Play24}" />
                        <ui:Button Margin="8,0,0,0" Command="{Binding OpenTestFolderCommand}" Content="{l:T 'Ordner mit den Ausschnitten öffnen', 'Open the folder with the clips'}" Icon="{ui:SymbolIcon FolderOpen24}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,12,0,-6"
                        FontSize="12"
                        Style="{StaticResource Muted}"
                        Text="{Binding TestedText}"
                        Visibility="{Binding TestedText, Converter={StaticResource TextVis}}" />
                    <Grid Margin="0,16,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource Muted}" Text="{l:T 'Ausschnitt', 'Clip'}" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Style="{StaticResource Muted}" Text="{l:T 'Größe', 'Size'}" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Style="{StaticResource Muted}" Text="{l:T 'zur Quelle', 'vs. source'}" />
                        <TextBlock Grid.Column="3" FontWeight="SemiBold" Style="{StaticResource Muted}" Text="{l:T 'ganze Datei ca.', 'whole file approx.'}" />
                        <TextBlock Grid.Column="4" FontWeight="SemiBold" Style="{StaticResource Muted}" Text="{l:T 'Bildqualität (SSIM, 1 = identisch)', 'Picture quality (SSIM, 1 = identical)'}" />
                    </Grid>
                    <Border Height="1" Margin="0,2,0,4" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <ItemsControl ItemsSource="{Binding TestRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Clip}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Size}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Ratio}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Full}" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Ssim}" TextTrimming="CharacterEllipsis" />
                                    <ui:Button
                                        Grid.Column="5"
                                        Padding="6"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.CompareCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:SymbolIcon SplitVertical24}"
                                        ToolTip="{l:T 'Bildvergleich mit dem Original', 'Picture comparison with the original'}"
                                        Visibility="{Binding CanCompare, Converter={StaticResource BoolVis}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12" Padding="20,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T 'Fertige Dateien nachbessern: Ton, Untertitel, Abspielbarkeit', 'Touch up finished files: audio, subtitles, playability'}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Korrigiert fertige Dateien, damit Fernseher sie direkt abspielen: einen zu hohen Video-Level und Ton, den sie nicht können (DTS, TrueHD, FLAC …). Auf Wunsch auch nach den Ton- und Untertitel-Regeln des Profils. Das Video wird nur kopiert, nichts wird neu kodiert, jede Datei wird vor dem Ersetzen geprüft. Angefasst werden nur MKV-Dateien, bei denen sich wirklich etwas ändert; sie werden an Ort und Stelle ersetzt.', 'Corrects finished files so TVs play them directly: a video level that is too high and audio they cannot play (DTS, TrueHD, FLAC …). Optionally also by the profile audio and subtitle rules. The video is only copied, nothing is re-encoded, each file is checked before replacing. Only MKV files that really change are touched; they are replaced in place.'}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T 'Ordner (leer = Zielordner des Profils), z.B. die Bibliothek des Medienservers', 'Folder (empty = profile target folder), e.g. the media server library'}" />
                    <DockPanel>
                        <ui:Button Margin="8,0,0,0" Command="{Binding PickCleanupFolderCommand}" DockPanel.Dock="Right" Icon="{ui:SymbolIcon FolderOpen24}" />
                        <TextBox Text="{Binding CleanupFolder, UpdateSourceTrigger=LostFocus}" />
                    </DockPanel>
                    <ui:ToggleSwitch Margin="0,14,0,0" Content="{l:T 'Auch Ton- und Untertitel-Regeln des Profils anwenden', 'Also apply the profile audio and subtitle rules'}" IsChecked="{Binding CleanupApplyRules}" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" Style="{StaticResource Muted}" Text="{l:T 'Sprachen, Kommentar, Hörfilm, Standardspur, Untertitel. Aus = nur Video-Level und Ton für Fernseher korrigieren, keine Spur entfällt.', 'Languages, commentary, audio description, default track, subtitles. Off = only correct video level and audio for TVs, no track is dropped.'}" TextWrapping="Wrap" />
                    <ui:ToggleSwitch Margin="0,10,0,0" Content="{l:T 'Nur anzeigen, was sich ändern würde (Probelauf)', 'Only show what would change (dry run)'}" IsChecked="{Binding CleanupDryRun}" />
                    <ui:Button Margin="0,14,0,0" Appearance="Primary" Command="{Binding StartCleanupCommand}" Content="{l:T 'Nachbessern starten', 'Start touch-up'}" Icon="{ui:SymbolIcon SpeakerEdit24}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T 'Prüflauf: fertige Dateien auf Schäden prüfen', 'Verification: check finished files for damage'}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Dekodiert alle Dateien im Zielordner vollständig und streng. Es wird nichts kodiert. Bereits geprüfte, unveränderte Dateien werden übersprungen. Mehrere PCs können gleichzeitig prüfen.', 'Fully and strictly decodes all files in the target folder. Nothing is encoded. Files already checked and unchanged are skipped. Multiple PCs can verify at the same time.'}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T 'Nur Dateien der letzten Tage prüfen (0 = alle)', 'Only check files from the last days (0 = all)'}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="90" Text="{Binding VerifyDays, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <ui:ToggleSwitch Margin="0,14,0,0" Content="{l:T 'Beschädigte Dateien nach _Defekt verschieben (der nächste normale Lauf kodiert sie neu aus der Quelle)', 'Move damaged files to _Defekt (the next normal run re-encodes them from the source)'}" IsChecked="{Binding VerifyDelete}" />
                    <ui:Button Margin="0,14,0,0" Appearance="Primary" Command="{Binding StartVerifyCommand}" Content="{l:T 'Prüflauf starten', 'Start verification'}" Icon="{ui:SymbolIcon ShieldCheckmark24}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
