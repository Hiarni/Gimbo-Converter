<Page
    x:Class="FilmKonverter.App.Pages.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:FilmKonverter.App"
    xmlns:b="clr-namespace:FilmKonverter.App.Behaviors"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root"
    Title="{l:T 'Konvertieren', 'Convert'}"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <DataTemplate x:Key="TargetItem">
            <RadioButton
                Margin="0,0,0,8"
                VerticalContentAlignment="Top"
                GroupName="ConvertTarget"
                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                IsEnabled="{Binding IsAvailable}">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" />
                    <TextBlock FontSize="12" Style="{StaticResource Muted}" Text="{Binding Description}" />
                </StackPanel>
            </RadioButton>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24,8,24,20" AllowDrop="True" Background="Transparent" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T 'Konvertieren', 'Convert'}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}" Text="{l:T 'Bringt einzelne Dateien in ein anderes Format, unabhängig von der Bibliothek. Dateien oder Ordner hierher ziehen, Ziel wählen, starten. Jedes Ergebnis wird geprüft, bestehende Dateien werden nie überschrieben.', 'Converts individual files into another format, independent of the library. Drag files or folders here, choose a target, start. Every result is checked, existing files are never overwritten.'}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Margin="0,0,16,0" b:Wheel.ScrollPage="True" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ui:Card Margin="0,0,0,8" Padding="16,12" IsEnabled="{Binding IsIdle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T 'Verpackung wechseln (verlustfrei)', 'Change container (lossless)'}" />
                            <ItemsControl ItemTemplate="{StaticResource TargetItem}" ItemsSource="{Binding RemuxTargets}" />
                            <TextBlock Margin="0,8,0,8" Style="{StaticResource SectionTitle}" Text="{l:T 'Für Geräte (neu kodiert)', 'For devices (re-encoded)'}" />
                            <ItemsControl ItemTemplate="{StaticResource TargetItem}" ItemsSource="{Binding DeviceTargets}" />
                            <TextBlock Margin="0,8,0,8" Style="{StaticResource SectionTitle}" Text="{l:T 'Nur Ton', 'Audio only'}" />
                            <ItemsControl ItemTemplate="{StaticResource TargetItem}" ItemsSource="{Binding AudioTargets}" />
                            <TextBlock Margin="0,4,0,0" FontSize="12" Style="{StaticResource Muted}" Text="{Binding CapsText}" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Padding="16,12" IsEnabled="{Binding IsIdle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T 'Speichern', 'Save to'}" />
                            <RadioButton Margin="0,0,0,4" Content="{l:T 'Neben der Quelle', 'Next to the source'}" GroupName="ConvertOut" IsChecked="{Binding ToFolder, Converter={StaticResource Not}, Mode=TwoWay}" />
                            <RadioButton Content="{l:T 'In einen Ordner', 'Into a folder'}" GroupName="ConvertOut" IsChecked="{Binding ToFolder, Mode=TwoWay}" />
                            <DockPanel Margin="0,6,0,0" IsEnabled="{Binding ToFolder}">
                                <ui:Button Margin="8,0,0,0" Command="{Binding PickOutputDirCommand}" DockPanel.Dock="Right" Icon="{ui:SymbolIcon FolderOpen24}" />
                                <TextBox Text="{Binding OutputDir, UpdateSourceTrigger=LostFocus}" />
                            </DockPanel>
                            <ui:ToggleSwitch Margin="0,10,0,0" Content="{l:T 'Unterordner übernehmen', 'Keep subfolders'}" IsChecked="{Binding KeepStructure}" IsEnabled="{Binding ToFolder}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T 'Namenszusatz (optional, z.B. „(Handy)“)', 'Name suffix (optional, e.g. “(mobile)”)'}" />
                            <TextBox Text="{Binding Suffix, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T 'Gleichzeitige Dateien', 'Files at once'}" />
                            <ComboBox Width="90" HorizontalAlignment="Left" DisplayMemberPath="Text" ItemsSource="{Binding ParallelOptions}" SelectedValue="{Binding Parallel}" SelectedValuePath="Value" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Appearance="Primary" Command="{Binding StartCommand}" Content="{l:T 'Starten', 'Start'}" Icon="{ui:SymbolIcon Play24}" Visibility="{Binding IsIdle, Converter={StaticResource BoolVis}}" />
                            <ui:Button Command="{Binding TogglePauseCommand}" Content="{Binding IsPaused, Converter={StaticResource BoolText}, ConverterParameter={l:T 'Fortsetzen|Pause', 'Resume|Pause'}}" Icon="{ui:SymbolIcon Pause24}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                            <ui:Button Margin="8,0,0,0" Command="{Binding StopCommand}" Content="{l:T 'Abbrechen', 'Cancel'}" Icon="{ui:SymbolIcon Stop24}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                        <WrapPanel>
                            <ui:Button Margin="0,0,8,4" Command="{Binding AddFilesCommand}" Content="{l:T 'Dateien …', 'Files …'}" Icon="{ui:SymbolIcon DocumentAdd24}" />
                            <ui:Button Margin="0,0,8,4" Command="{Binding AddFolderCommand}" Content="{l:T 'Ordner …', 'Folder …'}" Icon="{ui:SymbolIcon FolderAdd24}" />
                            <ui:Button Margin="0,0,8,4" Command="{Binding RemoveFinishedCommand}" Icon="{ui:SymbolIcon CheckmarkCircle24}" ToolTip="{l:T 'Fertige aus der Liste nehmen', 'Remove finished from the list'}" />
                            <ui:Button Margin="0,0,8,4" Command="{Binding ClearCommand}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="{l:T 'Liste leeren', 'Clear list'}" />
                        </WrapPanel>
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}" Text="{Binding Summary}" />
                    <ProgressBar Height="4" Margin="0,8,0,0" Maximum="100" Value="{Binding TotalPercent}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    Padding="12,8"
                    Background="#262F81F7"
                    BorderBrush="#2F81F7"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding Message, Converter={StaticResource TextVis}}">
                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Message}" TextWrapping="Wrap" />
                </Border>

                <ui:Card Grid.Row="2" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasRows, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                            <ui:SymbolIcon HorizontalAlignment="Center" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="ArrowDownload24" />
                            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T 'Dateien oder Ordner hierher ziehen', 'Drag files or folders here'}" />
                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource Muted}" Text="{l:T 'Vor dem Start zeigt jede Zeile, was passiert und was verloren ginge.', 'Before starting, each row shows what happens and what would be lost.'}" />
                        </StackPanel>

                        <ItemsControl
                            Margin="8,8,4,8"
                            ItemsSource="{Binding Rows}"
                            ScrollViewer.CanContentScroll="True"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,4,6" Padding="12,8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Margin="0,5,0,0" VerticalAlignment="Top" Fill="{Binding StateBrush}" />
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" />
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SourceText}" TextWrapping="Wrap" ToolTip="{Binding Folder}" />
                                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding PlanText}" TextWrapping="Wrap" ToolTip="{Binding OutputPath}" Visibility="{Binding PlanText, Converter={StaticResource TextVis}}" />
                                                <TextBlock FontSize="12" Foreground="#E3B341" Text="{Binding WarnText}" TextWrapping="Wrap" Visibility="{Binding WarnText, Converter={StaticResource TextVis}}" />
                                                <ProgressBar Height="4" Margin="0,6,0,0" Maximum="100" Value="{Binding Percent}" Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" MaxWidth="260" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ProgressText}" Visibility="{Binding ProgressText, Converter={StaticResource TextVis}}" />
                                                <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{Binding ResultBrush}" Text="{Binding ResultText}" TextAlignment="Right" TextWrapping="Wrap" Visibility="{Binding ResultText, Converter={StaticResource TextVis}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                                                <ui:Button
                                                    Padding="6"
                                                    Appearance="Transparent"
                                                    Command="{Binding DataContext.OpenRowCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Icon="{ui:SymbolIcon FolderOpen24}"
                                                    ToolTip="{l:T 'Im Explorer zeigen (Ergebnis, sonst Quelle)', 'Show in Explorer (result, otherwise source)'}" />
                                                <ui:Button
                                                    Padding="6"
                                                    Appearance="Transparent"
                                                    Command="{Binding DataContext.RemoveRowCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Icon="{ui:SymbolIcon Dismiss24}"
                                                    IsEnabled="{Binding CanRemove}"
                                                    ToolTip="{l:T 'Aus der Liste nehmen', 'Remove from the list'}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</Page>
