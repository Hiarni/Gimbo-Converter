<ui:FluentWindow
    x:Class="FilmKonverter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:FilmKonverter.App"
    xmlns:pages="clr-namespace:FilmKonverter.App.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{l:T 'Gimbo Konverter', 'Gimbo Converter'}"
    Icon="pack://application:,,,/Assets/GimboKonverter.ico"
    Width="1320"
    Height="860"
    MinWidth="1000"
    MinHeight="640"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{l:T 'Gimbo Konverter', 'Gimbo Converter'}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/icon-32.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsPaneToggleVisible="True"
            OpenPaneLength="210"
            PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Start" TargetPageType="{x:Type pages:DashboardPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T 'Profile', 'Profiles'}" TargetPageType="{x:Type pages:ProfilesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Options24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T 'Bibliothek', 'Library'}" TargetPageType="{x:Type pages:LibraryPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DataPie24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T 'Statistik', 'Statistics'}" TargetPageType="{x:Type pages:StatsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DataHistogram24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T 'Werkzeuge', 'Tools'}" TargetPageType="{x:Type pages:ToolsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Wrench24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T 'Konvertieren', 'Convert'}" TargetPageType="{x:Type pages:ConvertPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowSwap24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T 'Reparieren', 'Repair'}" TargetPageType="{x:Type pages:RepairPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Toolbox24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T 'Umbenennen', 'Rename'}" TargetPageType="{x:Type pages:RenamePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Rename24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="ffmpeg" TargetPageType="{x:Type pages:FfmpegPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Video24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{l:T 'Einstellungen', 'Settings'}" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Click="OnExitClick" Content="{l:T 'Beenden', 'Exit'}" ToolTip="{l:T 'Programm beenden', 'Exit the program'}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Power24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
